package koflow

import koflow.Job
import koflow.JobAttempt
import koflow.JobCounts

record SchemaVersion(Int user_version)
record JournalMode(String journal_mode)
record TableCount(Int count)
record ApplicationId(Int application_id)

class JobStore {
    private String path

    public constructor(String path) {
        if (path.trim() == "" || path == ":memory:" || path.startsWith("file:")) {
            throw "Use um caminho de arquivo SQLite persistente"
        }
        this.path = path
        this.initialize()
    }

    private String connect() {
        var conn = db.connect("jdbc:sqlite:" + this.path)
        var ready = false
        try {
            db.query(conn, "PRAGMA busy_timeout = 5000")
            var mode = db.query<koflow.JournalMode>(conn, "PRAGMA journal_mode")
            if (mode.get(0).journal_mode != "delete") {
                throw "O banco precisa usar journal_mode DELETE"
            }
            db.execute(conn, "PRAGMA synchronous = FULL")
            ready = true
            return conn
        } finally {
            if (!ready) {
                db.close(conn)
            }
        }
    }

    private void initialize() {
        var conn = this.connect()
        var started = false
        var committed = false
        try {
            db.execute(conn, "BEGIN IMMEDIATE")
            started = true
            var version = db.query<koflow.SchemaVersion>(conn, "PRAGMA user_version").get(0).user_version
            var application = db.query<koflow.ApplicationId>(conn, "PRAGMA application_id").get(0).application_id
            if (version == 0) {
                var tables = db.query<koflow.TableCount>(conn, "SELECT count(*) AS count FROM sqlite_master WHERE name NOT LIKE 'sqlite_%'")
                if (tables.get(0).count != 0 || application != 0) {
                    throw "O arquivo precisa ser um banco dedicado ao Koflow"
                }
                this.createSchema(conn)
            } else if (version == 1 && application == 1263488844) {
                this.migrateToV2(conn)
                this.migrateToV3(conn)
            } else if (version == 2 && application == 1263488844) {
                this.migrateToV3(conn)
            } else if (version != 3 || application != 1263488844) {
                throw "Versão de schema não suportada"
            }
            db.query<koflow.Job>(conn, "SELECT id, kind, payload, status, attempts, max_attempts, lease_until, last_error, available_at FROM jobs LIMIT 0")
            db.query<koflow.JobAttempt>(conn, "SELECT job_id, attempt, started_at, finished_at, result, error FROM job_attempts LIMIT 0")
            db.execute(conn, "COMMIT")
            committed = true
        } finally {
            try {
                if (started && !committed) {
                    db.execute(conn, "ROLLBACK")
                }
            } finally {
                db.close(conn)
            }
        }
    }

    private void createSchema(String conn) {
        db.execute(conn, "CREATE TABLE jobs (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT NOT NULL UNIQUE, kind TEXT NOT NULL CHECK(length(kind) BETWEEN 1 AND 200), payload TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending','running','succeeded','failed')), attempts INTEGER NOT NULL DEFAULT 0 CHECK(attempts >= 0 AND attempts <= max_attempts), max_attempts INTEGER NOT NULL CHECK(max_attempts BETWEEN 1 AND 1000), lease_until INTEGER NOT NULL DEFAULT 0, last_error TEXT NOT NULL DEFAULT '', available_at INTEGER NOT NULL DEFAULT 0, terminal_at INTEGER, CHECK((status = 'running' AND lease_until > 0 AND attempts > 0) OR (status != 'running' AND lease_until = 0)))")
        db.execute(conn, "CREATE INDEX jobs_pending ON jobs(kind, status, seq)")
        db.execute(conn, "CREATE INDEX jobs_expired ON jobs(kind, status, lease_until)")
        this.createAttempts(conn)
        db.execute(conn, "PRAGMA user_version = 3")
        db.execute(conn, "PRAGMA application_id = 1263488844")
    }

    private void createAttempts(String conn) {
        db.execute(conn, "CREATE TABLE job_attempts (seq INTEGER PRIMARY KEY AUTOINCREMENT, job_id TEXT NOT NULL, attempt INTEGER NOT NULL CHECK(attempt > 0), started_at INTEGER NOT NULL CHECK(started_at >= 0), finished_at INTEGER NOT NULL DEFAULT 0, result TEXT NOT NULL DEFAULT 'running' CHECK(result IN ('running','succeeded','failed','expired')), error TEXT NOT NULL DEFAULT '', UNIQUE(job_id, attempt), CHECK((result = 'running' AND finished_at = 0) OR (result <> 'running' AND finished_at >= 0)))")
    }

    private void migrateToV2(String conn) {
        db.execute(conn, "ALTER TABLE jobs ADD COLUMN available_at INTEGER NOT NULL DEFAULT 0")
        this.createAttempts(conn)
        db.execute(conn, "INSERT INTO job_attempts(job_id, attempt, started_at) SELECT id, attempts, 0 FROM jobs WHERE status = 'running'")
        db.execute(conn, "PRAGMA user_version = 2")
    }

    private void migrateToV3(String conn) {
        db.execute(conn, "ALTER TABLE jobs ADD COLUMN terminal_at INTEGER")
        db.execute(conn, "PRAGMA user_version = 3")
    }

    public String enqueue(String kind, String payload, Int maxAttempts) {
        return this.insert(kind, payload, maxAttempts, 0L)
    }

    public String enqueueAt(String kind, String payload, Int maxAttempts, Long availableAt) {
        if (availableAt < 0 || availableAt > 9223372036768375807L) {
            throw "Instante de disponibilidade inválido"
        }
        return this.insert(kind, payload, maxAttempts, availableAt)
    }

    private String insert(String kind, String payload, Int maxAttempts, Long availableAt) {
        this.validateKind(kind)
        if (maxAttempts < 1 || maxAttempts > 1000) {
            throw "maxAttempts deve estar entre 1 e 1000"
        }
        var id = uuid.v4()
        var conn = this.connect()
        var started = false
        var committed = false
        try {
            db.execute(conn, "BEGIN IMMEDIATE")
            started = true
            var inserted = db.execute(conn, "INSERT INTO jobs(id, kind, payload, max_attempts) VALUES (?, ?, ?, ?)", id, kind, payload, maxAttempts)
            if (inserted != 1) {
                throw "Job não foi persistido"
            }
            if (availableAt > 0L) {
                var scheduled = db.execute(conn, "UPDATE jobs SET available_at = ? WHERE id = ?", availableAt, id)
                if (scheduled != 1) {
                    throw "Job não foi agendado"
                }
            }
            db.execute(conn, "COMMIT")
            committed = true
            return id
        } finally {
            try {
                if (started && !committed) {
                    db.execute(conn, "ROLLBACK")
                }
            } finally {
                db.close(conn)
            }
        }
    }

    public Job get(String id) {
        var conn = this.connect()
        try {
            var rows = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE id = ?", id)
            if (rows.size == 0) {
                throw "Job não encontrado"
            }
            return rows.get(0)
        } finally {
            db.close(conn)
        }
    }

    public List<JobAttempt> attempts(String id) {
        var conn = this.connect()
        try {
            var rows = db.query<koflow.JobAttempt>(conn, "SELECT job_id, attempt, started_at, finished_at, result, error FROM job_attempts WHERE job_id = ? ORDER BY attempt", id)
            if (rows.size == 0) {
                var jobs = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE id = ?", id)
                if (jobs.size == 0) {
                    throw "Job não encontrado"
                }
            }
            return rows
        } finally {
            db.close(conn)
        }
    }

    public List<Job> claim(String kind, Long now, Long leaseMillis) {
        this.validateKind(kind)
        if (now < 0 || now > 9223372036768375807L || leaseMillis < 1 || leaseMillis > 86400000L) {
            throw "Relógio ou duração da concessão inválidos"
        }
        var conn = this.connect()
        var started = false
        var committed = false
        try {
            db.execute(conn, "BEGIN IMMEDIATE")
            started = true
            this.recoverExpired(conn, kind, now)
            var rows = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'pending' AND available_at <= ? ORDER BY seq LIMIT 1", kind, now)
            if (rows.size > 0) {
                var id = rows.get(0).id
                var changed = db.execute(conn, "UPDATE jobs SET status = 'running', attempts = attempts + 1, lease_until = ? WHERE id = ? AND status = 'pending'", now + leaseMillis, id)
                if (changed != 1) {
                    throw "Não foi possível conceder a execução do job"
                }
                rows = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE id = ?", id)
                var pending = db.query<koflow.TableCount>(conn, "SELECT count(*) AS count FROM job_attempts WHERE job_id = ? AND result = 'running'", id)
                if (pending.get(0).count != 0) {
                    throw "Job tem tentativa anterior ainda aberta no histórico"
                }
                var opened = db.execute(conn, "INSERT INTO job_attempts(job_id, attempt, started_at) VALUES (?, ?, ?)", id, rows.get(0).attempts, now)
                if (opened != 1) {
                    throw "Tentativa não foi registrada"
                }
            }
            db.execute(conn, "COMMIT")
            committed = true
            return rows
        } finally {
            try {
                if (started && !committed) {
                    db.execute(conn, "ROLLBACK")
                }
            } finally {
                db.close(conn)
            }
        }
    }

    private void recoverExpired(String conn, String kind, Long now) {
        var stale = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'running' AND lease_until <= ? ORDER BY seq", kind, now)
        var index = 0
        while (index < stale.size) {
            var lost = stale.get(index)
            var closed = db.execute(conn, "UPDATE job_attempts SET result = 'expired', finished_at = ?, error = 'Prazo de execução expirado' WHERE job_id = ? AND attempt = ? AND result = 'running'", now, lost.id, lost.attempts)
            if (closed != 1) {
                throw "Histórico incoerente com a concessão expirada"
            }
            var released = db.execute(conn, "UPDATE jobs SET status = CASE WHEN attempts >= max_attempts THEN 'failed' ELSE 'pending' END, lease_until = 0, last_error = 'Prazo de execução expirado' WHERE id = ? AND attempts = ? AND status = 'running'", lost.id, lost.attempts)
            if (released != 1) {
                throw "Concessão expirada não foi liberada"
            }
            var after = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE id = ?", lost.id).get(0)
            if (after.status == "failed") {
                this.markTerminal(conn, lost.id, now)
            }
            index = index + 1
        }
    }

    public Bool succeed(Job job, Long now) {
        this.validateClock(now)
        var conn = this.connect()
        var started = false
        var committed = false
        var acknowledged = false
        try {
            db.execute(conn, "BEGIN IMMEDIATE")
            started = true
            var changed = db.execute(conn, "UPDATE jobs SET status = 'succeeded', lease_until = 0, last_error = '', available_at = 0, terminal_at = ? WHERE id = ? AND attempts = ? AND status = 'running' AND lease_until > ?", now, job.id, job.attempts, now)
            if (changed == 1) {
                var closed = db.execute(conn, "UPDATE job_attempts SET result = 'succeeded', finished_at = ?, error = '' WHERE job_id = ? AND attempt = ? AND result = 'running'", now, job.id, job.attempts)
                if (closed != 1) {
                    throw "Histórico incoerente com o estado do job"
                }
                acknowledged = true
            }
            db.execute(conn, "COMMIT")
            committed = true
            return acknowledged
        } finally {
            try {
                if (started && !committed) {
                    db.execute(conn, "ROLLBACK")
                }
            } finally {
                db.close(conn)
            }
        }
    }

    public Bool fail(Job job, String error, Long now) {
        this.validateClock(now)
        var detail = error
        if (detail.length > 4096) {
            detail = detail.substring(0, 4096)
        }
        var conn = this.connect()
        var started = false
        var committed = false
        var acknowledged = false
        try {
            db.execute(conn, "BEGIN IMMEDIATE")
            started = true
            var changed = db.execute(conn, "UPDATE jobs SET status = CASE WHEN attempts >= max_attempts THEN 'failed' ELSE 'pending' END, lease_until = 0, last_error = ? WHERE id = ? AND attempts = ? AND status = 'running' AND lease_until > ?", detail, job.id, job.attempts, now)
            if (changed == 1) {
                var closed = db.execute(conn, "UPDATE job_attempts SET result = 'failed', finished_at = ?, error = ? WHERE job_id = ? AND attempt = ? AND result = 'running'", now, detail, job.id, job.attempts)
                if (closed != 1) {
                    throw "Histórico incoerente com o estado do job"
                }
                var state = db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE id = ?", job.id).get(0)
                if (state.status == "pending") {
                    var delay = this.backoffFor(job.attempts)
                    var next = now + delay + this.jitterFor(job.id, job.attempts, delay)
                    var scheduled = db.execute(conn, "UPDATE jobs SET available_at = ? WHERE id = ? AND status = 'pending'", next, job.id)
                    if (scheduled != 1) {
                        throw "Reentrega do job não foi agendada"
                    }
                } else {
                    this.markTerminal(conn, job.id, now)
                }
                acknowledged = true
            }
            db.execute(conn, "COMMIT")
            committed = true
            return acknowledged
        } finally {
            try {
                if (started && !committed) {
                    db.execute(conn, "ROLLBACK")
                }
            } finally {
                db.close(conn)
            }
        }
    }

    private void markTerminal(String conn, String id, Long now) {
        var marked = db.execute(conn, "UPDATE jobs SET terminal_at = ? WHERE id = ? AND status IN ('succeeded', 'failed') AND terminal_at IS NULL", now, id)
        if (marked != 1) {
            throw "Instante terminal do job não foi registrado"
        }
    }

    public Int purge(String kind, Long before, Int limit) {
        this.validateKind(kind)
        this.validateClock(before)
        if (limit < 1 || limit > 10000) {
            throw "limit deve estar entre 1 e 10000"
        }
        var conn = this.connect()
        var started = false
        var committed = false
        var removed = 0
        try {
            db.execute(conn, "BEGIN IMMEDIATE")
            started = true
            var expected = db.query<koflow.TableCount>(conn, "SELECT count(*) AS count FROM (SELECT id FROM jobs WHERE kind = ? AND status IN ('succeeded', 'failed') AND terminal_at IS NOT NULL AND terminal_at < ? ORDER BY terminal_at, seq LIMIT ?)", kind, before, limit).get(0).count
            if (expected > 0) {
                db.execute(conn, "DELETE FROM job_attempts WHERE job_id IN (SELECT id FROM jobs WHERE kind = ? AND status IN ('succeeded', 'failed') AND terminal_at IS NOT NULL AND terminal_at < ? ORDER BY terminal_at, seq LIMIT ?)", kind, before, limit)
                var remaining = db.query<koflow.TableCount>(conn, "SELECT count(*) AS count FROM job_attempts WHERE job_id IN (SELECT id FROM jobs WHERE kind = ? AND status IN ('succeeded', 'failed') AND terminal_at IS NOT NULL AND terminal_at < ? ORDER BY terminal_at, seq LIMIT ?)", kind, before, limit).get(0).count
                if (remaining != 0) {
                    throw "Histórico dos jobs removidos não foi apagado"
                }
                removed = db.execute(conn, "DELETE FROM jobs WHERE id IN (SELECT id FROM jobs WHERE kind = ? AND status IN ('succeeded', 'failed') AND terminal_at IS NOT NULL AND terminal_at < ? ORDER BY terminal_at, seq LIMIT ?)", kind, before, limit)
                if (removed != expected) {
                    throw "Remoção de jobs terminais não confere com os candidatos"
                }
            }
            db.execute(conn, "COMMIT")
            committed = true
            return removed
        } finally {
            try {
                if (started && !committed) {
                    db.execute(conn, "ROLLBACK")
                }
            } finally {
                db.close(conn)
            }
        }
    }

    public JobCounts counts(String kind, Long now) {
        this.validateKind(kind)
        this.validateClock(now)
        var conn = this.connect()
        try {
            return db.query<koflow.JobCounts>(conn, "SELECT COALESCE(SUM(CASE WHEN status = 'pending' AND available_at <= ? THEN 1 ELSE 0 END), 0) AS pending_ready, COALESCE(SUM(CASE WHEN status = 'pending' AND available_at > ? THEN 1 ELSE 0 END), 0) AS pending_scheduled, COALESCE(SUM(CASE WHEN status = 'running' THEN 1 ELSE 0 END), 0) AS running, COALESCE(SUM(CASE WHEN status = 'succeeded' THEN 1 ELSE 0 END), 0) AS succeeded, COALESCE(SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END), 0) AS failed FROM jobs WHERE kind = ?", now, now, kind).get(0)
        } finally {
            db.close(conn)
        }
    }

    public List<Job> list(String kind, String category, Long now, Int limit) {
        this.validateKind(kind)
        this.validateClock(now)
        if (limit < 1 || limit > 10000) {
            throw "limit deve estar entre 1 e 10000"
        }
        var conn = this.connect()
        try {
            switch (category) {
                case "pending_ready":
                    return db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'pending' AND available_at <= ? ORDER BY seq LIMIT ?", kind, now, limit)
                case "pending_scheduled":
                    return db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'pending' AND available_at > ? ORDER BY seq LIMIT ?", kind, now, limit)
                case "running":
                    return db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'running' ORDER BY seq LIMIT ?", kind, limit)
                case "succeeded":
                    return db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'succeeded' ORDER BY seq LIMIT ?", kind, limit)
                case "failed":
                    return db.query<koflow.Job>(conn, "SELECT * FROM jobs WHERE kind = ? AND status = 'failed' ORDER BY seq LIMIT ?", kind, limit)
                default:
                    throw "Categoria inválida: use pending_ready, pending_scheduled, running, succeeded ou failed"
            }
        } finally {
            db.close(conn)
        }
    }

    private Long backoffFor(Int attempt) {
        var delay = 1000L
        var step = 1
        while (step < attempt && delay < 3600000L) {
            delay = delay * 2L
            step = step + 1
        }
        if (delay > 3600000L) {
            delay = 3600000L
        }
        return delay
    }

    private Long jitterFor(String id, Int attempt, Long delay) {
        var ceiling = delay * 20L / 100L
        if (ceiling < 1L) {
            return 0L
        }
        var mixed = 17L
        var index = 0
        while (index < id.length) {
            mixed = (mixed * 31L + id.charAt(index)) % 1000003L
            index = index + 1
        }
        mixed = (mixed * 31L + attempt) % 1000003L
        return mixed % (ceiling + 1L)
    }

    private void validateClock(Long now) {
        if (now < 0 || now > 9223372036768375807L) {
            throw "Relógio inválido"
        }
    }

    private void validateKind(String kind) {
        if (kind.trim() == "" || kind.length > 200) {
            throw "kind deve ter entre 1 e 200 caracteres"
        }
    }
}
