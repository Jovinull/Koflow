import koflow.JobStore
import koflow.Worker
import koflow.JobHandler

class PrintHandler implements JobHandler {
    public void execute(String id, String payload, Int attempt) {
        println("Executando " + id + " (tentativa " + attempt + "): " + payload)
    }
}

main() {
    var store = JobStore(config.str("database", "jobs.db"))
    var action = config.str("action", "work")
    switch (action) {
        case "enqueue":
            var id = store.enqueue("print.v1", config.str("payload", "Olá, Koflow!"), 3)
            println("Criado " + id)
        case "work":
            var worker = Worker(store, "print.v1", 60000L)
            var handler = PrintHandler()
            while (worker.runOnce(handler)) {
            }
            println("Sem jobs disponíveis")
        case "show":
            var job = store.get(config.str("id", ""))
            println(job.id + " " + job.status + " tentativas=" + job.attempts)
        default:
            throw "Ação inválida: use enqueue, work ou show"
    }
}
