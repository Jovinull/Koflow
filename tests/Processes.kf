import koflow.JobStore

void runProcessCase(String action) {
    var store = JobStore(config.env("TEST_DB"))
    switch (action) {
        case "seed":
            println(store.enqueue("process", "persistido em outro processo", 3))
        case "hold":
            holdClaim(store)
        case "recover":
            recoverClaim(store)
        case "race":
            raceClaim(store)
        case "verify-race":
            verifyRace()
        case "uncommitted":
            holdUncommitted()
        case "verify-rollback":
            assert(store.claim("process", time.now(), 1000L).size == 0)
            println("PASS escrita não confirmada revertida após SIGKILL")
        default:
            throw "Caso de processo desconhecido"
    }
}

void holdClaim(JobStore store) {
    var job = store.claim("process", time.now(), 2000L).get(0)
    assert(job.attempts == 1)
    println("CLAIMED " + job.id)
    while (true) {
        time.sleep(100)
    }
}

void recoverClaim(JobStore store) {
    var deadline = time.now() + 10000L
    var recovered = false
    while (!recovered && time.now() < deadline) {
        var rows = store.claim("process", time.now(), 60000L)
        if (rows.size > 0) {
            var job = rows.get(0)
            assert(job.attempts == 2)
            assert(job.payload == "persistido em outro processo")
            var history = store.attempts(job.id)
            assert(history.size == 2, "a tentativa morta e a nova precisam estar registradas")
            assert(history.get(0).result == "expired", "a tentativa do processo morto expira, não falha")
            assert(history.get(1).result == "running")
            assert(store.succeed(job, time.now()))
            var closed = store.attempts(job.id)
            assert(closed.get(1).result == "succeeded")
            assert(closed.get(0).result == "expired", "o histórico anterior não é reescrito")
            println("RECOVERED " + job.id)
            recovered = true
        } else {
            time.sleep(20)
        }
    }
    assert(recovered, "recovery não ocorreu no prazo")
}

void raceClaim(JobStore store) {
    var rows = store.claim("process", time.now(), 60000L)
    if (rows.size > 0) {
        assert(rows.get(0).attempts == 1)
        println("WON")
    } else {
        println("EMPTY")
    }
}

void verifyRace() {
    var store = JobStore(config.env("TEST_DB"))
    var conn = db.connect("jdbc:sqlite:" + config.env("TEST_DB"))
    var rows = db.query<koflow.Job>(conn, "SELECT * FROM jobs")
    assert(rows.size == 1)
    assert(rows.get(0).status == "running")
    assert(rows.get(0).attempts == 1)
    db.close(conn)
    var history = store.attempts(rows.get(0).id)
    assert(history.size == 1, "oito processos não podem gerar mais de uma tentativa")
    assert(history.get(0).attempt == 1)
    assert(history.get(0).result == "running")
}

void holdUncommitted() {
    var conn = db.connect("jdbc:sqlite:" + config.env("TEST_DB"))
    db.execute(conn, "BEGIN IMMEDIATE")
    db.execute(conn, "INSERT INTO jobs(id,kind,payload,max_attempts) VALUES ('uncommitted','process','partial',1)")
    println("UNCOMMITTED")
    while (true) {
        time.sleep(100)
    }
}
